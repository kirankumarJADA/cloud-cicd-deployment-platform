# =============================================================================
# Environment template. Copy to `.env` and fill real values.
#   - Local dev:  cp .env.example docker/.env
#   - Production: this is rendered onto the VM at deployment/.env by deploy.sh
#
# NEVER commit a populated .env. The .gitignore already excludes it.
# In CI/CD these values come from GitHub Secrets (see .github/workflows).
# =============================================================================

# ---- Database ---------------------------------------------------------------
DATABASE_NAME=appdb
DATABASE_USERNAME=appuser
# Use a long random value. Generate: openssl rand -base64 24
DATABASE_PASSWORD=replace-with-strong-password

# ---- Security ---------------------------------------------------------------
# Must be >= 32 bytes for HS256. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_SECONDS=3600

# ---- Application ------------------------------------------------------------
APP_VERSION=1.0.0
APP_ENVIRONMENT=development

# ---- Container registry (used by deployment/docker-compose.prod.yml) --------
# For GitHub Container Registry: REGISTRY=ghcr.io
# For Docker Hub:                REGISTRY=docker.io
REGISTRY=ghcr.io
IMAGE_OWNER=your-github-username-or-org
IMAGE_TAG=latest

# ---- Remote deployment target (used by scripts/deploy.sh) -------------------
# These are normally injected by GitHub Actions from repository secrets and
# are only listed here for documentation / manual deployment.
SSH_HOST=your.server.ip.or.hostname
SSH_USER=deploy
